# Copy this to .env and fill in values, then restart Apache/PHP

# App
APP_TIMEZONE=Asia/Manila

# Mail settings
SAMS_MAIL_MODE=smtp
SAMS_MAIL_HOST=smtp.example.com
SAMS_MAIL_PORT=587
SAMS_MAIL_USERNAME=your-smtp-username@example.com
SAMS_MAIL_PASSWORD=your-smtp-password-or-app-password
SAMS_MAIL_ENCRYPTION=tls
SAMS_MAIL_FROM_EMAIL=no-reply@yourdomain.com
SAMS_MAIL_FROM_NAME="SAMS Notifications"

# Optional: route all outgoing mail to a test address (useful in dev)
#SAMS_MAIL_TEST_TO_EMAIL=developer+test@example.com
